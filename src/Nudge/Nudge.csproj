<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>nudge</AssemblyName>
    <RootNamespace>Nudge</RootNamespace>
    <Description>Turns raw Roslyn/SonarQube build diagnostics into coaching guides for AI coding agents. Habit Hooks pattern, native to .NET.</Description>
    <!-- Self-contained: no NuGet dependencies beyond the SDK. -->
    <!-- dotnet tool packaging: `dotnet tool install -g Nudge` -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nudge</ToolCommandName>
    <PackageId>Nudge</PackageId>
    <Version>1.0.0</Version>
    <Authors>Kenneth Cochran</Authors>
    <PackageTags>roslyn;sonarqube;analyzer;ai;coaching;habit-hooks</PackageTags>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nudge.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Ship the rule guides alongside the binary so the shim finds them with no explicit rules flag.
       CopyToOutputDirectory covers `dotnet run`; PackAsTool packs the build output (including rules/) into the nupkg. -->
  <ItemGroup>
    <None Include="rules/*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ship the nudge-ruleset-gen skill alongside the binary so `nudge skill install`
         can place it into AI harness skills directories. Same mechanism as rules/. -->
    <None Include="..\..\.agents\skills\nudge-ruleset-gen\**\*">
      <Link>skills\nudge-ruleset-gen\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\README.md">
      <Pack>true</Pack>
      <PackagePath>README.md</PackagePath>
    </None>
  </ItemGroup>

</Project>
